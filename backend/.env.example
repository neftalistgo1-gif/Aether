DATABASE_URL=postgresql+psycopg://aether:aether@localhost:5432/aether
MIKROTIK_TIMEOUT_SECONDS=10
AUTH_SESSION_HOURS=12

# UISP debe usar un token de solo lectura. Nunca lo subas a Git.
# Ejemplo: https://uisp.tu-dominio.local
UISP_ENDPOINT_URL=
UISP_API_TOKEN=
UISP_TIMEOUT_SECONDS=15
UISP_VERIFY_TLS=true

# Se usa una sola vez para crear el primer administrador.
# Debe ser largo, aleatorio y diferente de cualquier contraseña.
AETHER_BOOTSTRAP_SECRET=

# Las credenciales reales permanecen solamente en .env.
# Sustituye PRINCIPAL por el credential_key configurado para cada router:
# MIKROTIK_PRINCIPAL_USERNAME=
# MIKROTIK_PRINCIPAL_PASSWORD=
