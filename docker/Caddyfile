{$AETHER_DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 16MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(self), geolocation=(), microphone=()"
        -Server
    }

    reverse_proxy backend:8000 {
        health_uri /ready
        health_interval 30s
        health_timeout 5s
    }
}
