# Desarrollo local. En producción se usan DATABASE_HOST/NAME/USER y
# DATABASE_PASSWORD_FILE mediante docker/compose.production.yml.
DATABASE_URL=postgresql+psycopg://aether:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/aether
MIKROTIK_TIMEOUT_SECONDS=10
AUTH_SESSION_HOURS=12

# Directorio persistente para comprobantes, contratos y catálogos privados.
# AETHER_PRIVATE_STORAGE_PATH=/srv/aether/private_storage

# UISP debe usar un token de solo lectura. Nunca lo subas a Git.
# Ejemplo: https://uisp.tu-dominio.local
UISP_ENDPOINT_URL=
UISP_API_TOKEN=
UISP_TIMEOUT_SECONDS=15
UISP_VERIFY_TLS=true

# Se usa una sola vez para crear el primer administrador.
# Debe ser largo, aleatorio y diferente de cualquier contraseña.
AETHER_BOOTSTRAP_SECRET=
# Alternativa recomendada en servidor:
# AETHER_BOOTSTRAP_SECRET_FILE=/run/secrets/aether_bootstrap_secret

# Las credenciales reales permanecen solamente en .env.
# Sustituye PRINCIPAL por el credential_key configurado para cada router:
# MIKROTIK_PRINCIPAL_USERNAME=
# MIKROTIK_PRINCIPAL_PASSWORD=
